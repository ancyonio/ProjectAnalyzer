CREATE OR REPLACE PACKAGE BODY ORDER_APP.CUSTOMER_PKG AS

  PROCEDURE CREATE_CUSTOMER(p_name VARCHAR2) AS
  BEGIN
    INSERT INTO ORDER_APP.CUSTOMERS (CUSTOMER_ID, NAME)
    VALUES (ORDER_APP.ORDER_SEQ.NEXTVAL, p_name);
    AUDIT_PKG.LOG_ACTION('CUSTOMERS', 'INSERT');
  END;

  PROCEDURE DELETE_CUSTOMER(p_customer_id NUMBER) AS
  BEGIN
    DELETE FROM ORDER_APP.CUSTOMERS WHERE CUSTOMER_ID = p_customer_id;
  END;

  FUNCTION GET_CUSTOMER(p_customer_id NUMBER) RETURN VARCHAR2 AS
    l_name VARCHAR2(200);
  BEGIN
    SELECT NAME INTO l_name
      FROM ORDER_APP.CUSTOMERS
     WHERE CUSTOMER_ID = p_customer_id;
    RETURN l_name;
  EXCEPTION
    WHEN OTHERS THEN NULL;
  END;

  FUNCTION GET_CUSTOMER(p_name VARCHAR2) RETURN NUMBER AS
    l_id NUMBER;
  BEGIN
    SELECT CUSTOMER_ID INTO l_id FROM ORDER_APP.CUSTOMERS WHERE NAME = p_name;
    RETURN l_id;
  END;

  -- Private to the body: nothing calls it, so it should read as dead.
  PROCEDURE UNUSED_HELPER AS
  BEGIN
    NULL;
  END;

END CUSTOMER_PKG;
