CREATE OR REPLACE PACKAGE BODY ORDER_APP.AUDIT_PKG AS

  PROCEDURE LOG_ACTION(p_table VARCHAR2, p_action VARCHAR2) AS
  BEGIN
    INSERT INTO ORDER_APP.AUDIT_LOG (TABLE_NAME, ACTION)
    VALUES (p_table, p_action);
  END;

  -- No WHERE clause: affects every row.
  PROCEDURE PURGE_OLD_LOGS AS
  BEGIN
    DELETE FROM ORDER_APP.AUDIT_LOG;
    COMMIT;
  END;

END AUDIT_PKG;
