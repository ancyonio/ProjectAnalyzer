<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no" name="demo.OrderIntake"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/demo/OrderIntake"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:tns="http://www.example.org/Order"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../Schemas/Order.xsd"
        namespace="http://www.example.org/Order"/>

    <bpws:variables>
        <bpws:variable element="tns:Order" name="Start" sca-bpel:internal="true"/>
        <bpws:variable element="tns:OrderAck" name="End-input" sca-bpel:internal="true"/>

        <!-- BW6 binds a shared resource through a process property: the
             literal is the resource's fully-qualified name. -->
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>demo.Demo_JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>

        <bpws:variable name="jmsConnection" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/bw/models/sharedresource/jms}JMSConnectionFactory"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>demo.Demo_JMSConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
    </bpws:variables>

    <bpws:links>
        <bpws:link name="StartToJDBCQuery"/>
        <bpws:link name="JDBCQueryToJMSSend"/>
    </bpws:links>

    <bpws:sequence>
        <bpws:extensionActivity>
            <tibex:receiveEvent createInstance="yes" eventTimeout="0"
                name="JMSReceiveOrder" variable="Start"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                <bpws:sources>
                    <bpws:source linkName="StartToJDBCQuery"/>
                </bpws:sources>
                <tibex:eventSource>
                    <bwext:BWActivity activityTypeID="bw.jms.receive"
                        version="6.0.0"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiverEventSource"/>
                                <value connectionReference="jmsConnection"
                                    destinationName="ORDERS.INBOUND"
                                    messagingStyle="Queue"
                                    xsi:type="jms:JMSReceiverEventSource"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:eventSource>
            </tibex:receiveEvent>
        </bpws:extensionActivity>

        <bpws:extensionActivity>
            <tibex:activityExtension name="JDBCQuery"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                <bpws:targets>
                    <bpws:target linkName="StartToJDBCQuery"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="JDBCQueryToJMSSend"/>
                </bpws:sources>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.jdbc.query"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:jdbc="http://ns.tibco.com/bw/palette/jdbc"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT order_id, customer_id FROM orders WHERE status = ?"
                                    xsi:type="jdbc:JDBCQueryActivity"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>

        <bpws:extensionActivity>
            <tibex:activityExtension name="JMSSend"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToJMSSend"/>
                </bpws:targets>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.jms.send"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/jms#//JMSSendActivity"/>
                                <value destination="ORDERS.INBOUND"
                                    connectionReference="jmsConnection"
                                    xsi:type="jms:JMSSendActivity"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
    </bpws:sequence>
</bpws:process>
