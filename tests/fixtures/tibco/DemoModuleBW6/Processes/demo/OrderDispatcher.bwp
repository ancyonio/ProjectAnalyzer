<?xml version="1.0" encoding="UTF-8"?>
<!-- A callable subprocess caller. BW6 emits some call-process activities with
     no activityTypeID at all, so the call target is the only evidence that the
     activity is a subprocess call rather than unclassified custom work. -->
<bpws:process exitOnStandardFault="no" name="demo.OrderDispatcher"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/demo/OrderDispatcher"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <bpws:links>
        <bpws:link name="TimerToCall"/>
    </bpws:links>

    <bpws:sequence>
        <bpws:extensionActivity>
            <tibex:receiveEvent createInstance="yes" eventTimeout="0"
                name="DispatchTimer"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                <bpws:sources>
                    <bpws:source linkName="TimerToCall"/>
                </bpws:sources>
                <tibex:eventSource>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.timer"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"/>
                </tibex:eventSource>
            </tibex:receiveEvent>
        </bpws:extensionActivity>

        <bpws:extensionActivity>
            <tibex:activityExtension name="OrderIntakeCallProcess"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                <bpws:targets>
                    <bpws:target linkName="TimerToCall"/>
                </bpws:targets>
                <tibex:config>
                    <processName>demo.OrderIntake</processName>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
    </bpws:sequence>
</bpws:process>
